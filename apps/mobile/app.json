{
  "expo": {
    "name": "لمّة",
    "slug": "lamma",
    "scheme": "lamma",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lamma.app",
      "infoPlist": { "CFBundleAllowMixedLocalizations": true, "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.lamma.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro", "output": "single" },
    "plugins": ["expo-router", "expo-secure-store", "expo-localization", "expo-font"],
    "extra": { "supportsRTL": true }
  }
}
